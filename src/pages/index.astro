---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Vinayak Vikram',
  url: Astro.site?.href,
  sameAs: ['https://github.com/vinayak-vikram'],
};
---
<BaseLayout title="Vinayak Vikram" structuredData={structuredData}>
  <ul class="post-list">
    {posts.map(post => (
      <li>
        <span class="post-date">{post.data.date}</span>
        <a class="post-title" href={post.data.redirect ?? `/posts/${post.id}`}>{post.data.title}</a>
        {post.data.description && (
          <p class="post-excerpt">{post.data.description}</p>
        )}
      </li>
    ))}
  </ul>
</BaseLayout>
